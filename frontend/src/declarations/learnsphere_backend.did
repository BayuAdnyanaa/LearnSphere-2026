type UserStats = 
 record {
   experience: nat;
   questsCompleted: vec nat;
   tokens: nat;
 };
type Turn = 
 record {
   fromLearner: bool;
   "text": text;
 };
type Reply = 
 variant {
   limited: record {
              reason: text;
              retryAfterSeconds: nat;
            };
   ok: record {"text": text;};
   rejected: record {reason: text;};
   unavailable: record {reason: text;};
 };
type QuizResult = 
 variant {
   failed: record {retryAfterSeconds: nat;};
   passed: record {
             experienceEarned: nat;
             tokensEarned: nat;
           };
   rejected: record {reason: text;};
   wait: record {retryAfterSeconds: nat;};
 };
type Quest = 
 record {
   category: text;
   description: text;
   id: nat;
   link: text;
   prerequisite: opt nat;
   rewardAmount: nat;
   title: text;
 };
type PublicQuiz = 
 record {
   questId: nat;
   questions: vec PublicQuestion;
 };
type PublicQuestion = 
 record {
   options: vec text;
   "text": text;
 };
type Mode = 
 variant {
   llmCanister;
   off;
   proxy;
 };
service : {
  askTutor: (question: text, turns: vec Turn) -> (Reply);
  getAllQuests: () -> (vec Quest) query;
  getAllQuestsWithStatus: () -> (vec record {
                                       Quest;
                                       text;
                                     });
  getCooldowns: () -> (vec record {
                             nat;
                             nat;
                           }) query;
  getNextQuest: () -> (opt Quest);
  getQuestById: (questId: nat) -> (opt Quest) query;
  getQuestCount: () -> (nat) query;
  getQuiz: (questId: nat) -> (opt PublicQuiz) query;
  getUserStats: () -> (UserStats);
  greet: (name: text) -> (text) query;
  setTutorMode: (mode: Mode) -> ();
  setTutorProxy: (url: text, secret: text) -> ();
  submitQuiz: (questId: nat, answers: vec nat) -> (QuizResult);
  tutorUsageToday: () ->
   (record {
      calls: nat;
      cap: nat;
      day: nat;
      learners: nat;
      mode: Mode;
      proxyConfigured: bool;
    }) query;
}
