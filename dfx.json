{
  "canisters": {
    "learnsphere_backend": {
      "main": "backend/src/backend/main.mo",
      "type": "motoko",
      "dependencies": [
        "internet_identity",
        "llm"
      ],
      "declarations": {
        "output": "frontend/src/declarations"
      }
    },
    "learnsphere_frontend": {
      "dependencies": [
        "learnsphere_backend"
      ],
      "type": "assets",
      "source": [
        "frontend/dist"
      ],
      "build": [
        "npm --prefix frontend install",
        "npm --prefix frontend run build"
      ]
    },
    "internet_identity": {
      "type": "custom",
      "candid": "https://github.com/dfinity/internet-identity/releases/download/release-2026-02-28/internet_identity.did",
      "wasm": "https://github.com/dfinity/internet-identity/releases/download/release-2026-02-28/internet_identity_dev.wasm.gz",
      "init_arg": "(opt record { captcha_config = opt record { max_unsolved_captchas = 50:nat64; captcha_trigger = variant { Static = variant { CaptchaDisabled } } }; dummy_auth = opt opt record { prompt_for_index = false } })",
      "remote": {
        "id": {
          "ic": "rdmx6-jaaaa-aaaaa-aaadq-cai"
        }
      },
      "frontend": {},
      "declarations": {
        "bindings": []
      }
    },
    "llm": {
      "type": "motoko",
      "main": "backend/src/llm_mock/main.mo",
      "remote": {
        "candid": "backend/src/llm_mock/llm.did",
        "id": {
          "ic": "w36hm-eqaaa-aaaal-qr76a-cai"
        }
      },
      "declarations": {
        "bindings": []
      }
    }
  },
  "dfx": "0.31.0",
  "output_env_file": ".env",
  "defaults": {
    "build": {
      "args": "",
      "packtool": ""
    }
  },
  "networks": {
    "local": {
      "bind": "127.0.0.1:4943",
      "type": "ephemeral"
    }
  },
  "version": 1
}
